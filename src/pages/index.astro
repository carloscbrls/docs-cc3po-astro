---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Knowledge Base">
  <div class="hero">
    <div class="hero-badge">📚 Knowledge Base</div>
    <h1>Find answers, fix fast.</h1>
    <p>15+ years of experience in plain language. Search below or pick a topic to get started.</p>
    
    <div class="search-container">
      <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/>
        <path d="m21 21-4.35-4.35"/>
      </svg>
      <input type="text" class="search-input" placeholder="Search for a solution..." id="search-input" />
      <kbd class="search-kbd">⌘K</kbd>
    </div>
  </div>
  
  <div class="section-header">
    <span class="section-label">🔥 Most Needed</span>
  </div>
  <div class="cards-grid urgent">
    <a href="/troubleshooting/common-issues" class="card card-urgent">
      <div class="card-icon urgent">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
          <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
      </div>
      <div class="card-content">
        <h3>Common Issues & Fixes</h3>
        <p>Site down? Email going to spam? Can't log in? Here's what to do — in plain English, no jargon.</p>
      </div>
      <svg class="card-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 12h14m-7-7 7 7-7 7"/>
      </svg>
    </a>
    
    <a href="/troubleshooting/quick-fixes" class="card card-urgent">
      <div class="card-icon urgent">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
        </svg>
      </div>
      <div class="card-content">
        <h3>Quick Fixes</h3>
        <p>Copy-paste solutions for the problems we see every day. Most take under 5 minutes.</p>
      </div>
      <svg class="card-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 12h14m-7-7 7 7-7 7"/>
      </svg>
    </a>
  </div>

  <div class="section-header">
    <span class="section-label">📖 Guides</span>
  </div>
  <div class="cards-grid">
    <a href="/guides/wordpress/wordpress-setup" class="card">
      <div class="card-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="3" width="18" height="18" rx="2"/>
          <path d="M3 9h18M9 21V9"/>
        </svg>
      </div>
      <div class="card-content">
        <h3>WordPress Guides</h3>
        <p>Setup, security, optimization, and best practices for your WordPress site.</p>
      </div>
      <svg class="card-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 12h14m-7-7 7 7-7 7"/>
      </svg>
    </a>
    
    <a href="/guides/ai/ai-automation-workflows" class="card">
      <div class="card-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M12 2a4 4 0 0 1 4 4v2a4 4 0 0 1-8 0V6a4 4 0 0 1 4-4z"/>
          <path d="M16 14v2a4 4 0 0 1-8 0v-2M12 14v4M8 18v2M16 18v2M8 22h8"/>
        </svg>
      </div>
      <div class="card-content">
        <h3>AI & Automation</h3>
        <p>How your AI assistant works, workflows, chatbot setup, and getting the most from automation.</p>
      </div>
      <svg class="card-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 12h14m-7-7 7 7-7 7"/>
      </svg>
    </a>
    
    <a href="/guides/agent-system/client-guide" class="card">
      <div class="card-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M9 11l3 3L22 4"/>
          <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
        </svg>
      </div>
      <div class="card-content">
        <h3>Getting Started</h3>
        <p>Set up your AI assistant in 5 minutes — connect, say hello, and start delegating tasks.</p>
      </div>
      <svg class="card-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 12h14m-7-7 7 7-7 7"/>
      </svg>
    </a>
    
    <a href="/guides/agent-system/security" class="card">
      <div class="card-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="M9 12l2 2 4-4"/>
        </svg>
      </div>
      <div class="card-content">
        <h3>Security & Privacy</h3>
        <p>How your data stays safe — SSL, encryption, monitoring, and privacy explained.</p>
      </div>
      <svg class="card-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 12h14m-7-7 7 7-7 7"/>
      </svg>
    </a>
    
    <a href="/guides/agent-system/faq" class="card">
      <div class="card-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="12" r="10"/>
          <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
          <line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
      </div>
      <div class="card-content">
        <h3>FAQ</h3>
        <p>Common questions answered — what your AI assistant does, how it works, pricing, and more.</p>
      </div>
      <svg class="card-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 12h14m-7-7 7 7-7 7"/>
      </svg>
    </a>
  </div>
  
  <div class="help-cta-section">
    <div class="help-cta-card">
      <div class="help-cta-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          <path d="M8 9h8M8 13h6"/>
        </svg>
      </div>
      <div class="help-cta-content">
        <h2>Can't find what you need?</h2>
        <p>Our team is here to help. Get personalized support for any question about AI automation, WordPress, security, HIPAA compliance, or our services.</p>
      </div>
    </div>
    <form class="help-cta-form" action="https://formspree.io/f/xbdwggel" method="POST">
      <input type="hidden" name="_subject" value="CC3PO Docs — New Support Request" />
      <input type="hidden" name="source" value="docs.cc3po.com" />
      <div class="form-row">
        <div class="form-group">
          <label for="help-name">Name</label>
          <input type="text" id="help-name" name="name" placeholder="Your name" required />
        </div>
        <div class="form-group">
          <label for="help-email">Email</label>
          <input type="email" id="help-email" name="email" placeholder="you@company.com" required />
        </div>
      </div>
      <div class="form-group">
        <label for="help-message">What do you need help with?</label>
        <textarea id="help-message" name="message" rows="3" placeholder="Tell us what you're looking for..." required></textarea>
      </div>
      <button type="submit" class="help-cta-button">
        Send Message
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
      </button>
    </form>
  </div>

  <footer class="footer">
    <div class="footer-links">
      <a href="https://cc3po.com">CC3PO Ecosystem</a>
      <span class="footer-divider">·</span>
      <a href="https://insights.cc3po.com">Blog</a>
      <span class="footer-divider">·</span>
      <a href="https://offers.cc3po.com">Services</a>
    </div>
    <a href="https://offers.cc3po.com" class="cta-link">Need help? Get expert support →</a>
    <div class="footer-legal">
      <a href="/terms">Terms</a>
      <span class="footer-divider">·</span>
      <a href="/privacy">Privacy</a>
      <span class="footer-divider">·</span>
      <a href="/disclaimer">Disclaimer</a>
    </div>
  </footer>

<script>
  // Search input now triggers the global search modal (⌘K)
  // Actual search logic lives in SearchModal.astro
</script>
</Layout>